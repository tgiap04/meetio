+        final IntentFilter filter = new IntentFilter(reactContext.getPackageName() + RNBackgroundActionsTask.ACTION_BUTTON_INTENT);
+        // Not exported: only this app's own PendingIntents reach it (required on Android 14+).
+        ContextCompat.registerReceiver(reactContext, actionReceiver, filter, ContextCompat.RECEIVER_NOT_EXPORTED);
+    }
+
+    @Override
+    public void invalidate() {
+        try {
+            reactContext.unregisterReceiver(actionReceiver);
+        } catch (IllegalArgumentException ignored) {
+            // Already unregistered.
+        }
+        super.invalidate();
     }
 
