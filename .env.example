# Copy to .env and fill in real values. Never commit the real file.

# --- Environment -------------------------------------------------------------
NODE_ENV=development

# --- apps/api ------------------------------------------------------------
PORT=
DATABASE_URL=
REDIS_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# One or more Gemini keys, comma-separated — used in turn; a key that hits 429 rests
# (Gemini's retryDelay, default 60s; a daily quota rests until the next Pacific day).
# Quotas are per Google Cloud project, so extra keys only help from different projects.
GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=gemini-flash-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_MAX_CONCURRENCY=4
# GEMINI_KEY_COOLDOWN_MS=60000
CORS_ORIGIN=
# Danh sách audience (client ID) mà server chấp nhận cho Google ID token, phân tách bằng dấu phẩy.
GOOGLE_OAUTH_AUDIENCES=
# Bật Swagger UI tại /api/docs. true|1|yes|on = bật.
# Để trống = bật khi NODE_ENV khác 'production', tắt khi production.
# Giá trị lạ (gõ sai) = TẮT — an toàn trước, tránh biến một lỗi typo thành lộ toàn bộ API.
SWAGGER_ENABLED=

# --- docker-compose (postgres / redis) ---------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
REDIS_PORT=

# --- apps/mobile (EXPO_PUBLIC_* is bundled into the client — no secrets here) --
# Phải kết thúc bằng /api vì server gắn global prefix 'api' (apps/api/src/main.ts).
# Ví dụ: http://localhost:3000/api — thiếu hậu tố này thì mọi request 404 mà không
# có gì trong lỗi chỉ ra nguyên nhân.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WS_URL=
# --- Google Sign-In (client ID là định danh CÔNG KHAI, không phải bí mật) ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
