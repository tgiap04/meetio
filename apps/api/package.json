{
  "name": "@meetio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "yarn test:unit && yarn test:e2e",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "openapi:generate": "nest build && node dist/generate-openapi.js",
    "migration:run": "node --env-file-if-exists=../../.env --import tsx src/database/migrate.ts up",
    "migration:revert": "node --env-file=../../.env --import tsx src/database/migrate.ts down",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx src/database/seed.ts",
    "start:local": "node dist/main.js",
    "load-test": "node --env-file-if-exists=../../.env --import tsx scripts/load-test-meeting-room.ts",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns='\\.e2e\\.spec\\.ts$'",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit --testPathPatterns='\\.e2e\\.spec\\.ts$'"
  },
  "dependencies": {
    "@meetio/shared": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/platform-socket.io": "^12.1.0",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/typeorm": "^12.0.1",
    "@nestjs/websockets": "^12.1.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.1",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^22.20.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.1",
    "jsonwebtoken": "9.0.3",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "5.6.3"
  }
}
