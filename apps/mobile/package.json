{
  "name": "@meetio/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"app/**/*.tsx\" \"app/**/*.ts\" \"src/**/*.tsx\" \"src/**/*.ts\"",
    "build": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@meetio/shared": "workspace:*",
    "@tanstack/react-query": "^5.103.1",
    "axios": "^1.20.0",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.29.0",
    "react-native-reanimated": "~4.6.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.28.0",
    "react-native-worklets": "~0.12.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "babel-preset-expo": "~57.0.12",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "react-refresh": "^0.19.0",
    "react-test-renderer": "19.2.3",
    "typescript": "5.6.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "^@meetio/shared$": "<rootDir>/../../packages/shared/src/index.ts"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ]
  }
}
